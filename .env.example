# Copy to .env and fill in. Never commit .env — this file holds placeholders only.
# Backend variables are read by backend/app/config.py; NEXT_PUBLIC_* are read by the
# frontend at build time.

# --- Application ---
APP_ENV=local                       # local | ci | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000  # comma-separated
FRONTEND_BASE_URL=http://localhost:3000

# --- Database ---
# Supabase → Project Settings → Database → Connection string (URI).
# Use the session pooler (port 5432) for the API; the app rewrites the scheme to asyncpg.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Local Postgres used only by the test suite (see docker-compose.yml).
TEST_DATABASE_URL=postgresql+asyncpg://portal:portal@localhost:5433/portal_test

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server-only, bypasses RLS — never expose
SUPABASE_JWT_SECRET=<jwt-secret>               # verifies Supabase Auth tokens server-side
SUPABASE_STORAGE_BUCKET=phi-assets

# --- Email (Resend) ---
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=noreply@example.com

# --- Policy knobs (documented in the README) ---
SHARE_LINK_TTL_HOURS=48
IDENTITY_VERIFICATION_TTL_MINUTES=30
IDENTITY_MAX_ATTEMPTS=5
IDENTITY_LOCKOUT_MINUTES=15

# --- Frontend (build-time, publicly visible — never put secrets here) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>
