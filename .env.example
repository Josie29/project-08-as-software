# Copy to .env and fill in. Never commit .env — this file holds placeholders only.
# Backend variables are read by backend/app/config.py; NEXT_PUBLIC_* are read by the
# frontend at build time.

# --- Application ---
APP_ENV=local                       # local | ci | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000  # comma-separated
FRONTEND_BASE_URL=http://localhost:3000

# --- Database ---
# Supabase dashboard → Connect (top bar) → Session pooler, URI format.
# Session pooler (port 5432), not the transaction pooler (6543): pgbouncer transaction
# mode breaks asyncpg's prepared statements. The app rewrites the scheme to asyncpg.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Local Postgres used only by the test suite (see docker-compose.yml).
TEST_DATABASE_URL=postgresql+asyncpg://portal:portal@localhost:5433/portal_test

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server-only, bypasses RLS — never expose
# No JWT secret: the project signs tokens with an asymmetric ES256 key, so the API
# verifies them against <SUPABASE_URL>/auth/v1/.well-known/jwks.json (derived, not configured).
SUPABASE_STORAGE_BUCKET=phi-assets

# Supabase's session pooler caps the project at 15 concurrent clients. A rolling deploy
# runs two containers at once, so 2 x (POOL_SIZE + MAX_OVERFLOW) must stay under 15.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# --- Email (Resend) ---
RESEND_API_KEY=<resend-api-key>
# Must be a sender Resend will accept: onboarding@resend.dev works without setup but only
# delivers to your own Resend account address. Arbitrary recipients need a verified domain.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Policy knobs (documented in the README) ---
SHARE_LINK_TTL_HOURS=48
IDENTITY_VERIFICATION_TTL_MINUTES=30
IDENTITY_MAX_ATTEMPTS=5
IDENTITY_LOCKOUT_MINUTES=15
# How far ahead availability rules are materialised into bookable slot rows.
SLOT_HORIZON_DAYS=60
# Minimum notice for a patient to reschedule or cancel their own appointment.
BOOKING_MIN_NOTICE_HOURS=24
# How far before the start time an appointment reminder is sent, and how often the
# in-process job looks for due ones. Run it by hand with `python -m app.reminders`.
REMINDER_LEAD_HOURS=24
REMINDER_POLL_MINUTES=15
# Set false to run the API without the background reminder job (used by the load tests).
REMINDER_SCHEDULER_ENABLED=true

# --- Frontend (build-time, publicly visible — never put secrets here) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>
